{
  "scopeName": "source.naso",
  "name": "Naso",
  "fileTypes": ["naso"],
  "injectionSelector": "L:source.naso",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#parameters" },
    { "include": "#quantum_intrinsics" },
    { "include": "#tensor_operations" },
    { "include": "#polyhedral" },
    { "include": "#modules" },
    { "include": "#variables" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#control_flow" },
    { "include": "#structs_enums" },
    { "include": "#attributes" },
    { "include": "#special_identifiers" },
    { "include": "#lifetimes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.naso",
          "match": "//.*"
        },
        {
          "name": "comment.block.naso",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        },
        {
          "name": "comment.documentation.naso",
          "match": "^\\s*///.*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.naso",
          "match": "\\b(if|else|while|for|match|return|break|continue|loop)\\b"
        },
        {
          "name": "keyword.declaration.naso",
          "match": "\\b(fn|struct|enum|type|const|static|let|mut|module|import|pub|crate|super|self)\\b"
        },
        {
          "name": "keyword.other.naso",
          "match": "\\b(forall|tile|fuse|uncompute|defer|unsafe|as|in|where|fn)\\b"
        },
        {
          "name": "keyword.operator.naso",
          "match": "\\b(and|or|not|xor)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.naso",
          "match": "\\b(bool|u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f16|f32|f64|char|str|never|unit|qubit|qir::qubit)\\b"
        },
        {
          "name": "storage.type.quantity.naso",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#quantity_content" }
          ]
        },
        {
          "name": "storage.type.generic.naso",
          "begin": "\\b[A-Z][a-zA-Z0-9_]*",
          "end": ">",
          "patterns": [
            { "include": "#types" }
          ]
        },
        {
          "name": "storage.type.function.naso",
          "match": "\\bfn\\s*\\("
        },
        {
          "name": "storage.type.tuple.naso",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#types" }
          ]
        },
        {
          "name": "storage.type.array.naso",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#types" }
          ]
        },
        {
          "name": "storage.type.reference.naso",
          "match": "&(?:\\'[a-zA-Z_][a-zA-Z0-9_]*)?(?:\\s+mut)?\\s+[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "storage.type.inout.naso",
          "match": "\\binout\\b"
        }
      ]
    },
    "quantity_content": {
      "patterns": [
        {
          "name": "constant.numeric.quantity.naso",
          "match": "\\b(0|1|\\*|[0-9]+)\\b"
        },
        {
          "name": "variable.other.quantity.naso",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.naso",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.naso",
          "match": "^\\s*fn\\s+([A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.naso",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*:"
        },
        {
          "name": "storage.modifier.inout.naso",
          "match": "\\binout\\b"
        }
      ]
    },
    "quantum_intrinsics": {
      "patterns": [
        {
          "name": "support.function.quantum.naso",
          "match": "\\b(qalloc|qfree|hadamard|pauli_x|pauli_y|pauli_z|phase|cnot|cz|swap|toffoli|fredkin|measure|bell_pair|ghz_state|w_state|qft|grover_oracle|grover_diffusion|amplitude_amplification|phase_estimation|quantum_teleportation|superdense_coding|reset|barrier|delay)\\b"
        }
      ]
    },
    "tensor_operations": {
      "patterns": [
        {
          "name": "support.function.tensor.naso",
          "match": "\\b(matmul|matvec|vecmat|outer_product|inner_product|tensor_product|contract|transpose|permute|reshape|slice|concatenate|split|einsum|svd|qr|eig|cholesky|lu|inv|det|trace|norm|normalize|softmax|log_softmax)\\b"
        }
      ]
    },
    "polyhedral": {
      "patterns": [
        {
          "name": "keyword.control.polyhedral.naso",
          "match": "\\b(forall|tile|fuse)\\b"
        },
        {
          "name": "storage.type.schedule.naso",
          "match": "#\\[schedule\\([^\\]]*\\)\\]"
        },
        {
          "name": "constant.other.schedule.naso",
          "match": "\\b(parallel|sequential|tiled|fused|vectorized|gpu|cpu|quantum)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "keyword.other.module.naso",
          "match": "\\b(module|import|from|as)\\b"
        },
        {
          "name": "entity.name.namespace.naso",
          "match": "(?<=module\\s)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.namespace.naso",
          "match": "(?<=import\\s)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.declaration.naso",
          "match": "\\b(let|const|static)\\s+(mut\\s+)?[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.naso",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.naso",
          "match": "\\b[0-9]+(_[0-9]+)*([uif](8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.hex.naso",
          "match": "\\b0x[0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.octal.naso",
          "match": "\\b0o[0-7]+(_[0-7]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.naso",
          "match": "\\b0b[01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.naso",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*([f](32|64))?\\b"
        },
        {
          "name": "string.quoted.double.naso",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.naso", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.naso",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.naso", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.language.boolean.naso",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.unit.naso",
          "match": "\\(\\)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.naso",
          "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|==|!=|<=|>=|<|>|&&|\\|\\||\\+|-|\\*|/|%|&|\\||\\^|<<|>>|!|~)"
        }
      ]
    },
    "control_flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.naso",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.repeat.naso",
          "match": "\\b(while|for|loop)\\b"
        },
        {
          "name": "keyword.control.return.naso",
          "match": "\\breturn\\b"
        }
      ]
    },
    "structs_enums": {
      "patterns": [
        {
          "name": "entity.name.type.struct.naso",
          "match": "(?<=struct\\s)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.type.enum.naso",
          "match": "(?<=enum\\s)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.member.naso",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*:"
        },
        {
          "name": "entity.name.variant.naso",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute.naso",
          "match": "#\\[[^\\]]*\\]"
        }
      ]
    },
    "special_identifiers": {
      "patterns": [
        {
          "name": "variable.language.naso",
          "match": "\\b(self|Self|super|crate)\\b"
        }
      ]
    },
    "lifetimes": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.naso",
          "match": "\\'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}