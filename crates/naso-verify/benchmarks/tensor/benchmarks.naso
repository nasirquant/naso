    let c = alloc_tensor([4, 4]);
    return ();
}

// Valid: Convolution with bounded tensors
fn conv2d_3x3(input: [1] i32, kernel: [1] i32) {
    let output = alloc_tensor([30, 30]);
    return ();
}

// Valid: Attention computation
fn attention(q: [1] i32, k: [1] i32, v: [1] i32) {
    let scores = alloc_tensor([64, 64]);
    let attn = alloc_tensor([64, 64]);
    let output = alloc_tensor([64, 64]);
    return ();
}

// Valid: Tensor contraction
fn contract_ijk_kl(a: [1] i32, b: [1] i32) {
    let c = alloc_tensor([8, 8]);
    return ();
}

// Valid: Element-wise operations with linear buffers
fn elementwise_add(a: [1] i32, b: [1] i32) {
    let c = alloc_tensor([100]);
    return ();
}

// Valid: Transpose with inout for mutation
fn transpose_inout(m: [1] i32) {
    return ();
}

// Invalid: Unbounded tensor without allocation (should error)
fn unbounded_tensor_error() {
    let t: [*] i32;
    return ();
}

// Invalid: Linear tensor used twice
fn linear_tensor_double_use(t: [1] i32) {
    linear_free(t);
    linear_free(t);
    return ();
}

// Invalid: Tensor leak
fn tensor_leak(t: [1] i32) {
    return ();
}

