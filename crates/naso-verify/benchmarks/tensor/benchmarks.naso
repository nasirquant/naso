// Invalid: Linear tensor used twice
fn linear_tensor_double_use(t: [1] Tensor[10]) {
    linear_free(t);
    linear_free(t); // Double free!
}

// Invalid: Tensor leak
fn tensor_leak(t: [1] Tensor[10]) {
    // t never consumed
}

// Invalid: Dimension mismatch in matmul
fn matmul_dim_mismatch(a: [1] Tensor[4, 5], b: [1] Tensor[6, 4]) -> [1] Tensor[4, 4] {
    // Incompatible dimensions: 5 != 6
    let c = alloc_tensor([4, 4]);
    forall i in 0..4, j in 0..4 {
        let mut sum = 0.0;
        forall k in 0..5 { // a has 5, b has 6 rows
            sum = sum + a[i, k] * b[k, j]; // b[k, j] fails when k >= 6
        }
        c[i, j] = sum;
    }
    c
}