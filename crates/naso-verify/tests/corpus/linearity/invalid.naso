// Invalid: linear resource leaked (never consumed)
fn leak(x: [1] i32) {
    // x never consumed!
}

// Invalid: linear resource consumed twice
fn double_free(x: [1] i32) {
    linear_free(x);
    linear_free(x); // Double free!
}

// Invalid: linear resource consumed in only one branch
fn branch_leak(cond: bool, x: [1] i32) {
    if cond {
        linear_free(x);
    } else {
        // x leaked in else branch!
    }
}

// Invalid: linear resource moved then both consumed
fn move_then_double(x: [1] i32) {
    let y = x; // Move
    linear_free(x); // Error: x already moved
    linear_free(y);
}

// Invalid: linear resource returned but not consumed by caller
fn caller_leak() {
    let x = return_linear();
    // x never consumed!
}

fn return_linear() -> [1] i32 {
    linear_alloc(42)
}